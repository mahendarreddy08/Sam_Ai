rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.preferredLanguage is string;
      allow update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);

      // Notes Subcollection
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 500;
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string;
        allow delete: if isOwner(userId);
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.completed is bool;
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Memories Subcollection
      match /memories/{memoryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(memoryId)
          && request.resource.data.userId == userId
          && request.resource.data.key is string
          && request.resource.data.value is string;
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Reminders Subcollection
      match /reminders/{reminderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(reminderId)
          && request.resource.data.userId == userId
          && request.resource.data.message is string;
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Conversation Summaries Subcollection
      match /conversations/{conversationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(conversationId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string;
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // User Settings Document
      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
