{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(health|chat|feedback)",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
