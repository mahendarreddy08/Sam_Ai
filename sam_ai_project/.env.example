# Groq API Key for Generative AI fallback responses (server-side only)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=

# Groq LLaMA Model ID (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional PostgreSQL database connection for conversation & feedback logging (e.g. Neon, Supabase)
# Leave blank to run with database disabled
DATABASE_URL=

# Allowed origins for CORS in production (comma-separated, e.g. https://sam-ai.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
